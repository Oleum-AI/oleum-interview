# Copy to .env and fill in.  ->  cp .env.example .env

# --- Model -----------------------------------------------------------------------------
# Set the model and provide the matching API key below.
# OpenAI example:    LLM_MODEL=gpt-4o            (needs OPENAI_API_KEY)
# Anthropic example: LLM_MODEL=claude-sonnet-4-5 (needs ANTHROPIC_API_KEY)
LLM_MODEL=gpt-4o
LLM_PROVIDER=          # optional: openai | anthropic (auto-detected from the model name if blank)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Databricks SQL warehouse (provided to you before the interview) -------------------
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
